# ==============================================================================
# JORAWAR DHAM PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholders with production values.
# NEVER commit .env containing real credentials to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection String (Prisma format)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:YOUR_STRONG_PASSWORD@localhost:5432/jorawar_dham_db?schema=public"

# Admin Session Signing Secret (Must be minimum 32 random characters in production)
SESSION_SECRET="replace-with-a-minimum-32-char-cryptographically-random-secret-key"

# Initial Super Admin Seed Credentials (Used during prisma/seed.ts only)
SUPER_ADMIN_EMAIL="admin@jorawardham.org"
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_PASSWORD="CHANGE_THIS_ON_FIRST_LOGIN_1234!"

# Storage Configuration (Local storage for development; S3 compatible for production)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH="./storage/uploads"
# S3 / MinIO / Cloudflare R2 Credentials (for future production deployment)
# S3_ENDPOINT=
# S3_REGION=ap-south-1
# S3_BUCKET=jorawar-dham-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5
