# Application Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_SITE_URL=https://jorawardham.devnio.tech

# PostgreSQL Production Database (Internal container network or managed RDS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public&sslmode=prefer
POSTGRES_DB=jorawar_dham_db
POSTGRES_USER=jorawar_admin
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_HERE
DATABASE_URL="postgresql://jorawar_admin:GENERATE_STRONG_RANDOM_PASSWORD_HERE@postgres:5432/jorawar_dham_db?schema=public"

# Cryptographic Session Secrets (Generate with `openssl rand -hex 32`)
NEXTAUTH_SECRET=GENERATE_RANDOM_64_CHAR_HEX_KEY
ADMIN_SESSION_SECRET=GENERATE_RANDOM_64_CHAR_HEX_KEY
DEVOTEE_SESSION_SECRET=GENERATE_RANDOM_64_CHAR_HEX_KEY
TICKET_QR_HMAC_SECRET=GENERATE_RANDOM_64_CHAR_HEX_KEY

# Razorpay Payment Gateway (Live credentials from dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_test_TdNeogRV08MQef"
RAZORPAY_KEY_SECRET="qNUD5hkDgP8E8FTvhGRqQV2M"
RAZORPAY_WEBHOOK_SECRET="74469844307c75546e0ed178e32bf325b01bd9f0661a2fce"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_TdNeogRV08MQef"

# Notification Service Providers (Multi-channel abstraction)
